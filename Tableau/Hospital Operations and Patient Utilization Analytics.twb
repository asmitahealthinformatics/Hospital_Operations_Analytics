      <aliases enabled='yes' />
      <column caption='30 Day Readmission Rate' datatype='real' name='[Calculation_1983574466547712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [readmitted] = &quot;&lt;30&quot; THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([encounter_id])' />
      </column>
      <column caption='Prior Inpatient Visit Group' datatype='string' name='[Calculation_1983574468853761]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [number_inpatient] = 0 THEN &quot;0 visits&quot;&#13;&#10;ELSEIF [number_inpatient] = 1 THEN &quot;1 visit&quot;&#13;&#10;ELSEIF [number_inpatient] = 2 THEN &quot;2 visits&quot;&#13;&#10;ELSEIF [number_inpatient] = 3 THEN &quot;3 visits&quot;&#13;&#10;ELSE &quot;4+ visits&quot;&#13;&#10;END' />
      </column>
      <column caption='Prior Emergency Visit Group' datatype='string' name='[Calculation_1983574470615042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [number_emergency] = 0 THEN &quot;0 visits&quot;&#13;&#10;ELSEIF [number_emergency] = 1 THEN &quot;1 visit&quot;&#13;&#10;ELSEIF [number_emergency] = 2 THEN &quot;2 visits&quot;&#13;&#10;ELSEIF [number_emergency] = 3 THEN &quot;3 visits&quot;&#13;&#10;ELSE &quot;4+ visits&quot;&#13;&#10;END' />
      </column>
      <column caption='Admission Type Name' datatype='string' name='[Calculation_1983574474678275]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE INT([admission_type_id])&#13;&#10;WHEN 1 THEN &quot;Emergency&quot;&#13;&#10;WHEN 2 THEN &quot;Urgent&quot;&#13;&#10;WHEN 3 THEN &quot;Elective&quot;&#13;&#10;WHEN 4 THEN &quot;Newborn&quot;&#13;&#10;WHEN 5 THEN &quot;Not Available&quot;&#13;&#10;WHEN 6 THEN &quot;NULL / Unknown&quot;&#13;&#10;WHEN 7 THEN &quot;Trauma Center&quot;&#13;&#10;WHEN 8 THEN &quot;Not Mapped&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
