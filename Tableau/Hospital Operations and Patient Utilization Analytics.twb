              <calculation class='tableau' formula='CASE INT([admission_type_id])&#13;&#10;WHEN 1 THEN &quot;Emergency&quot;&#13;&#10;WHEN 2 THEN &quot;Urgent&quot;&#13;&#10;WHEN 3 THEN &quot;Elective&quot;&#13;&#10;WHEN 4 THEN &quot;Newborn&quot;&#13;&#10;WHEN 5 THEN &quot;Not Available&quot;&#13;&#10;WHEN 6 THEN &quot;NULL / Unknown&quot;&#13;&#10;WHEN 7 THEN &quot;Trauma Center&quot;&#13;&#10;WHEN 8 THEN &quot;Not Mapped&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Admission Type Id' datatype='integer' name='[admission_type_id]' role='dimension' type='ordinal' />
            <column caption='Encounter Id' datatype='integer' name='[encounter_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1983574474678275]' derivation='None' name='[none:Calculation_1983574474678275:nk]' pivot='key' type='nominal' />
            <column caption='Readmitted' datatype='string' name='[readmitted]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1983574466547712]' derivation='User' name='[usr:Calculation_1983574466547712:qk]' pivot='key' type='quantitative' />
