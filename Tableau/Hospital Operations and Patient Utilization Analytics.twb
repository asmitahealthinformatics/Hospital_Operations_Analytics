    <worksheet name='Chart - Readmission by Emergency Visits (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='diabetic_data_cleaned' name='federated.0vwu8we1du1h7o1g22log0rfcn7g' />
          </datasources>
          <datasource-dependencies datasource='federated.0vwu8we1du1h7o1g22log0rfcn7g'>
            <column caption='30 Day Readmission Rate' datatype='real' name='[Calculation_1983574466547712]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [readmitted] = &quot;&lt;30&quot; THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([encounter_id])' />
            </column>
            <column caption='Prior Emergency Visit Group' datatype='string' name='[Calculation_1983574470615042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [number_emergency] = 0 THEN &quot;0 visits&quot;&#13;&#10;ELSEIF [number_emergency] = 1 THEN &quot;1 visit&quot;&#13;&#10;ELSEIF [number_emergency] = 2 THEN &quot;2 visits&quot;&#13;&#10;ELSEIF [number_emergency] = 3 THEN &quot;3 visits&quot;&#13;&#10;ELSE &quot;4+ visits&quot;&#13;&#10;END' />
            </column>
            <column caption='Encounter Id' datatype='integer' name='[encounter_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1983574470615042]' derivation='None' name='[none:Calculation_1983574470615042:nk]' pivot='key' type='nominal' />
